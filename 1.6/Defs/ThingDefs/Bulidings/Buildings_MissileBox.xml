<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--模型关节、俯仰范围、伺服速度和目标策略均由本文件配置。-->
  <ThingDef ParentName="SSR_BuildingBase_Security">
    <defName>SSR_Turret_MissileBox</defName>
    <label>导弹发射箱</label>
    <description>四联装制导导弹发射箱。发射架可偏航和俯仰，开盖并瞄准后每隔 30 刻发射一枚箱内实体导弹，一轮齐射 4 枚，可攻击地面与空中威胁。整组补满后开始下一轮，停电暂停补充。</description>
    <thingClass>SSR.Combat.Offscreen.Building_TubeMissileTurret</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Security/MissileBox/MissileBox_MenuIcon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>Cutout</shaderType>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <uiIconPath>Things/Building/Security/MissileBox/MissileBox_MenuIcon_Isometric</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>1100</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>3200</WorkToBuild>
      <Mass>120</Mass>
      <Beauty>0</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>30</Steel>
      <SSR_Item_SpecialSteel>180</SSR_Item_SpecialSteel>
      <SSR_Item_StrongElectromagnet>20</SSR_Item_StrongElectromagnet>
      <SSR_Item_SuperconductingMaterial>10</SSR_Item_SuperconductingMaterial>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/Security/MissileBox/MissileBox_MenuIcon</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>(4.961836,4.961836)</drawSize>
        <drawOffset>(0,0,0.415875)</drawOffset>
      </blueprintGraphicData>
      <combatPower>130</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>SSR_TurretGun_MissileBox</turretGunDef>
      <turretBurstWarmupTime>0.01</turretBurstWarmupTime>
      <turretBurstCooldownTime>1</turretBurstCooldownTime>
      <turretTopDrawSize>0</turretTopDrawSize>
    </building>
    <placeWorkers>
      <li>SSR.Combat.Offscreen.PlaceWorker_OffscreenTurretRadius</li>
    </placeWorkers>
    <designationHotKey>Misc2</designationHotKey>
    <researchPrerequisites>
      <li>SSR_Research_BasicTurret</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>1800</basePowerConsumption>
      </li>
      <li Class="SSR.Combat.Offscreen.OffscreenPrefabProperties">
        <shaderForTestAssetBundle>Assets/SSR/Add.shader</shaderForTestAssetBundle>
        <assetDefs>
          <li>SSR_Animate_Prefab_Windows_Combat</li>
        </assetDefs>
        <leveledPrefabPaths>
          <li>Assets/SSR/Turrets/T1/Game/MissileBox.prefab</li>
        </leveledPrefabPaths>
        <modelRootPath>Root</modelRootPath>
      </li>
      <li>
        <compClass>FS_SSR.TC_SolarFlareLocalShield</compClass>
      </li>
    </comps>
    <modExtensions Inherit="False">
      <li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
        <innerCategory>SSR_DesignationInnerCategory_Security</innerCategory>
        <designatorClass>RimWorld.Designator_Build</designatorClass>
      </li>
      <li Class="SSR.Combat.Offscreen.TurretAimSettings">
        <yawAcceleration>240</yawAcceleration>
        <pitchAcceleration>180</pitchAcceleration>
        <yawAimTolerance>1</yawAimTolerance>
        <pitchAimTolerance>1</pitchAimTolerance>
        <aimConeTolerance>1.5</aimConeTolerance>
        <solverIterations>12</solverIterations>
        <allowManualTarget>true</allowManualTarget>
        <returnToIdle>true</returnToIdle>
        <idleDelayTicks>180</idleDelayTicks>
        <idleYaw>0</idleYaw>
        <idlePitch>0</idlePitch>
        <targeting>SSR_TurretTargeting_CombinedAirDefense</targeting>
        <yawRotationSpeed>60</yawRotationSpeed>
        <pitchRotationSpeed>45</pitchRotationSpeed>
        <shootingOrigine>Root/Yaw/Pitch/FirePoint</shootingOrigine>
        <rootTransform>Root</rootTransform>
        <yawPath>Root/Yaw</yawPath>
        <pitchPath>Root/Yaw/Pitch</pitchPath>
        <yawRotationAixe>(0,1,0)</yawRotationAixe>
        <pitchRotationAixe>(1,0,0)</pitchRotationAixe>
        <pitchRotationRange>(350,85)</pitchRotationRange>
        <shootingOrigineForward>(0,0,1)</shootingOrigineForward>
      </li>
      <li Class="SSR.Combat.Offscreen.TubeLauncherSettings">
        <missilePrefabPath>Assets/SSR/Turrets/T1/Game/MissileBoxPayload.prefab</missilePrefabPath>
        <missileProjectile>SSR_Projectile_MissileBox</missileProjectile>
        <reloadTicks>1200</reloadTicks>
        <ejectionSpeed>12</ejectionSpeed>
        <ejectionClearance>0.12</ejectionClearance>
        <ejectionGravity>9.81</ejectionGravity>
        <ignitionDelay>0.30</ignitionDelay>
        <minimumIgnitionHeight>0.2</minimumIgnitionHeight>
        <maximumSpeed>80</maximumSpeed>
        <acceleration>160</acceleration>
        <turnDegreesPerSecond>240</turnDegreesPerSecond>
        <fuseRadius>0.6</fuseRadius>
        <missileLifetimeTicks>600</missileLifetimeTicks>
        <missileSlots>
          <li>Root/Yaw/Pitch/Slots/Slot01</li>
          <li>Root/Yaw/Pitch/Slots/Slot02</li>
          <li>Root/Yaw/Pitch/Slots/Slot03</li>
          <li>Root/Yaw/Pitch/Slots/Slot04</li>
        </missileSlots>
        <exhaust>
          <flamePath>Assets/SSR/Missiles/Game/MissileFlame.prefab</flamePath>
          <smokePath>Assets/SSR/Missiles/Game/MissileSmoke.prefab</smokePath>
          <flameWidth>0.35</flameWidth>
          <flameLength>0.55</flameLength>
          <flameBrightness>1.35</flameBrightness>
          <ignitionFlareMultiplier>2</ignitionFlareMultiplier>
          <ignitionFlareSeconds>0.22</ignitionFlareSeconds>
          <flameTrailSeconds>0.18</flameTrailSeconds>
          <flameTrailLength>2.3</flameTrailLength>
          <flameGasSpeed>5</flameGasSpeed>
          <flameTurbulence>0.065</flameTurbulence>
          <smokeSpacing>0.2</smokeSpacing>
          <smokeLifetime>1.5</smokeLifetime>
          <smokeStartSize>0.3</smokeStartSize>
          <smokeEndSize>0.9</smokeEndSize>
          <smokeOpacity>0.2</smokeOpacity>
        </exhaust>
        <openingTicks>24</openingTicks>
        <doors>
          <li>
            <path>Root/Yaw/Pitch/Doors/Door01</path>
            <axis>(0,1,0)</axis>
            <openAngle>100</openAngle>
          </li>
          <li>
            <path>Root/Yaw/Pitch/Doors/Door02</path>
            <axis>(0,1,0)</axis>
            <openAngle>-100</openAngle>
          </li>
          <li>
            <path>Root/Yaw/Pitch/Doors/Door03</path>
            <axis>(0,1,0)</axis>
            <openAngle>100</openAngle>
          </li>
          <li>
            <path>Root/Yaw/Pitch/Doors/Door04</path>
            <axis>(0,1,0)</axis>
            <openAngle>-100</openAngle>
          </li>
        </doors>
      </li>
    </modExtensions>
    <uiOrder>2300</uiOrder>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>SSR_TurretGun_MissileBox</defName>
    <label>导弹发射箱</label>
    <description>四联装制导导弹发射箱。发射架可偏航和俯仰，开盖并瞄准后每隔 30 刻发射一枚箱内实体导弹，一轮齐射 4 枚，可攻击地面与空中威胁。整组补满后开始下一轮，停电暂停补充。</description>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>1.00</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>SSR.Combat.Offscreen.Verb_TubeMissile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SSR_Projectile_MissileBox</defaultProjectile>
        <!--原版要求爆炸弹丸配置正数偏移半径；实体导弹由专用发射器制导，不使用原版随机散布。-->
        <forcedMissRadius>0.1</forcedMissRadius>
        <warmupTime>0</warmupTime>
        <range>100</range>
        <ticksBetweenBurstShots>30</ticksBetweenBurstShots>
        <burstShotCount>4</burstShotCount>
        <muzzleFlashScale>0</muzzleFlashScale>
        <requireLineOfSight>false</requireLineOfSight>
        <stopBurstWithoutLos>false</stopBurstWithoutLos>
        <minRange>10</minRange>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>SSR_Projectile_MissileBox</defName>
    <label>导弹发射箱弹体</label>
    <thingClass>SSR.Combat.Offscreen.Projectile_GuidedDefenseMissile</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Missile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>90</damageAmountBase>
      <explosionRadius>4</explosionRadius>
      <explosionDelay>0</explosionDelay>
      <speed>60</speed>
      <flyOverhead>false</flyOverhead>
      <soundExplode>Explosion_Rocket</soundExplode>
    </projectile>
  </ThingDef>
</Defs>
