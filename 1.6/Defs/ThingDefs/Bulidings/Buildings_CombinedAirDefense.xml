<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--三格模型尺寸保存在预制体内部；菜单使用预先导出的透明 PNG。-->
  <SSR.Combat.Offscreen.TurretTargetingDef ParentName="SSR_TurretTargeting_Base">
    <defName>SSR_TurretTargeting_CombinedAirDefense</defName>
    <label>弹炮合一防空目标策略</label>
    <targetOverheadProjectiles>true</targetOverheadProjectiles>
    <targetSkyfallers>true</targetSkyfallers>
    <targetSpatialTargets>true</targetSpatialTargets>
    <maxTargetHeight>240</maxTargetHeight>
    <groundAimHeight>1</groundAimHeight>
  </SSR.Combat.Offscreen.TurretTargetingDef>
  <ThingDef ParentName="SSR_BuildingBase_Security">
    <defName>SSR_Turret_CombinedAirDefense</defName>
    <label>弹炮合一防空武器系统</label>
    <description>三乘三弹炮合一防空武器系统。八管近防炮与八枚筒射制导导弹共享锁定目标、独立俯仰，优先拦截空中威胁，也能打击地面敌人。导弹沿发射器当前瞄准轴冷弹射出筒，弹尾完全离筒后短暂惯性滑行，再点火持续追踪目标；各弹位独立冷却自动补充。近防炮使用特种钢补充弹药，后部平板雷达持续扫描。</description>
    <thingClass>SSR.Combat.Offscreen.Building_CombinedAirDefense</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Security/CombinedAirDefense/CombinedAirDefense_MenuIcon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>Cutout</shaderType>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <uiIconPath>Things/Building/Security/CombinedAirDefense/CombinedAirDefense_MenuIcon_Isometric</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>8</Mass>
      <Beauty>0</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>30</Steel>
      <SSR_Item_SpecialSteel>150</SSR_Item_SpecialSteel>
      <SSR_Item_StrongElectromagnet>20</SSR_Item_StrongElectromagnet>
      <SSR_Item_SuperconductingMaterial>10</SSR_Item_SuperconductingMaterial>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <blueprintGraphicData>
        <!--透明画布的地图尺寸与底面偏移与实际模型采集一致，保持蓝图和建筑对齐。-->
        <texPath>Things/Building/Security/CombinedAirDefense/CombinedAirDefense_MenuIcon</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>(6.074977,6.074977)</drawSize>
        <drawOffset>(0,0,0.071021)</drawOffset>
      </blueprintGraphicData>
      <combatPower>45</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>SSR_TurretGun_CombinedAirDefense</turretGunDef>
      <turretBurstWarmupTime>0.01</turretBurstWarmupTime>
      <turretBurstCooldownTime>0</turretBurstCooldownTime>
      <turretTopDrawSize>0</turretTopDrawSize>
    </building>
    <placeWorkers>
      <li>SSR.Combat.Offscreen.PlaceWorker_OffscreenTurretRadius</li>
    </placeWorkers>
    <designationHotKey>Misc2</designationHotKey>
    <researchPrerequisites>
      <li>SSR_Research_BasicTurret</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>射击直到弹药耗尽</fuelLabel>
        <fuelGizmoLabel>剩余弹药量</fuelGizmoLabel>
        <outOfFuelMessage>需要重新装填</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>SSR_Item_SpecialSteel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>1200</fuelCapacity>
        <fuelMultiplier>5</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>2000</basePowerConsumption>
      </li>
      <li Class="SSR.Combat.Offscreen.OffscreenPrefabProperties">
        <shaderForTestAssetBundle>Assets/SSR/Add.shader</shaderForTestAssetBundle>
        <assetDefs>
          <li>SSR_Animate_Prefab_Windows_Combat</li>
        </assetDefs>
        <leveledPrefabPaths>
          <li>Assets/SSR/Prefab/TurretT1_MGAA_2X.prefab</li>
        </leveledPrefabPaths>
        <modelRootPath>Root</modelRootPath>
        <barrelSpinTransformPath>Root/Yaw/Pitch/Rotor</barrelSpinTransformPath>
        <barrelCount>8</barrelCount>
        <barrelSpinAxis>(0,0,-1)</barrelSpinAxis>
        <barrelFirePhaseDegrees>0</barrelFirePhaseDegrees>
        <barrelSpinUpTicks>18</barrelSpinUpTicks>
        <barrelSpinDownTicks>30</barrelSpinDownTicks>
      </li>
      <li>
        <compClass>FS_SSR.TC_SolarFlareLocalShield</compClass>
      </li>
    </comps>
    <modExtensions Inherit="False">
      <li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
        <innerCategory>SSR_DesignationInnerCategory_Security</innerCategory>
        <designatorClass>RimWorld.Designator_Build</designatorClass>
      </li>
      <li Class="SSR.Combat.Offscreen.TurretAimSettings">
        <yawAcceleration>1440</yawAcceleration>
        <pitchAcceleration>480</pitchAcceleration>
        <yawAimTolerance>1</yawAimTolerance>
        <pitchAimTolerance>1</pitchAimTolerance>
        <aimConeTolerance>1.5</aimConeTolerance>
        <solverIterations>12</solverIterations>
        <allowManualTarget>true</allowManualTarget>
        <returnToIdle>true</returnToIdle>
        <idleDelayTicks>180</idleDelayTicks>
        <idleYaw>0</idleYaw>
        <idlePitch>0</idlePitch>
        <targeting>SSR_TurretTargeting_CombinedAirDefense</targeting>
        <yawRotationSpeed>360</yawRotationSpeed>
        <pitchRotationSpeed>120</pitchRotationSpeed>
        <shootingOrigine>Root/Yaw/Pitch/FirePoint</shootingOrigine>
        <rootTransform>Root</rootTransform>
        <yawPath>Root/Yaw</yawPath>
        <pitchPath>Root/Yaw/Pitch</pitchPath>
        <yawRotationAixe>(0,1,0)</yawRotationAixe>
        <pitchRotationAixe>(1,0,0)</pitchRotationAixe>
        <pitchRotationRange>(350,90)</pitchRotationRange>
        <shootingOrigineForward>(0,0,1)</shootingOrigineForward>
        <shootingSoundDef>SSR_Sound_Electromagnetic_CIWS</shootingSoundDef>
      </li>
      <li Class="SSR.Combat.Offscreen.CombinedAirDefenseSettings">
        <!--射程为水平格数；速度为格每秒，转速为度每秒，时间为游戏刻。-->
        <missilePrefabPath>Assets/SSR/CombinedDefense/Game/MGAAMissile.prefab</missilePrefabPath>
        <missileProjectile>SSR_Projectile_GuidedDefenseMissile</missileProjectile>
        <missileRange>65</missileRange>
        <launchIntervalTicks>30</launchIntervalTicks>
        <reloadTicks>600</reloadTicks>
        <!--两侧导弹架共用独立俯仰轴，不继承近防炮俯仰；偏航仍随整座炮塔。-->
        <missilePitchPath>Root/Yaw/MissilePitch</missilePitchPath>
        <missileAimPointPath>Root/Yaw/MissilePitch/AimPoint</missileAimPointPath>
        <missilePitchAxis>(1,0,0)</missilePitchAxis>
        <missilePitchRange>(350,90)</missilePitchRange>
        <missilePitchSpeed>60</missilePitchSpeed>
        <missilePitchAcceleration>240</missilePitchAcceleration>
        <!--冷弹射沿发射筒的当前瞄准轴从静止加速；离筒净空为格，重力为格每平方秒。-->
        <ejectionSpeed>8</ejectionSpeed>
        <ejectionClearance>0.12</ejectionClearance>
        <ejectionGravity>9.81</ejectionGravity>
        <!--弹尾完全离筒并达到净空后无动力滑行的秒数，此前没有尾焰或制导转向。-->
        <ignitionDelay>0.30</ignitionDelay>
        <!--低俯角时按最低弹体端点的高度限制滑行时间，在落地前留出制导恢复距离。-->
        <minimumIgnitionHeight>0.2</minimumIgnitionHeight>
        <maximumSpeed>72</maximumSpeed>
        <acceleration>160</acceleration>
        <turnDegreesPerSecond>240</turnDegreesPerSecond>
        <fuseRadius>0.6</fuseRadius>
        <missileLifetimeTicks>600</missileLifetimeTicks>
        <missileSlots>
          <li>Root/Yaw/MissilePitch/RackLeft/Slot01</li>
          <li>Root/Yaw/MissilePitch/RackRight/Slot02</li>
          <li>Root/Yaw/MissilePitch/RackLeft/Slot03</li>
          <li>Root/Yaw/MissilePitch/RackRight/Slot04</li>
          <li>Root/Yaw/MissilePitch/RackLeft/Slot05</li>
          <li>Root/Yaw/MissilePitch/RackRight/Slot06</li>
          <li>Root/Yaw/MissilePitch/RackLeft/Slot07</li>
          <li>Root/Yaw/MissilePitch/RackRight/Slot08</li>
        </missileSlots>
        <radars>
          <li>
            <path>Root/Yaw/RadarRear</path>
            <axis>(0,1,0)</axis>
            <degreesPerSecond>60</degreesPerSecond>
          </li>
        </radars>
        <!--喷焰和烟迹复用导弹井资源，按实际喷口历史生成弯曲尾迹。-->
        <exhaust>
          <flamePath>Assets/SSR/Missiles/Game/MissileFlame.prefab</flamePath>
          <smokePath>Assets/SSR/Missiles/Game/MissileSmoke.prefab</smokePath>
          <flameWidth>0.35</flameWidth>
          <flameLength>0.55</flameLength>
          <flameBrightness>1.35</flameBrightness>
          <ignitionFlareMultiplier>2</ignitionFlareMultiplier>
          <ignitionFlareSeconds>0.22</ignitionFlareSeconds>
          <flameTrailSeconds>0.18</flameTrailSeconds>
          <flameTrailLength>2.3</flameTrailLength>
          <flameGasSpeed>5</flameGasSpeed>
          <flameTurbulence>0.065</flameTurbulence>
          <smokeSpacing>0.2</smokeSpacing>
          <smokeLifetime>1.5</smokeLifetime>
          <smokeStartSize>0.3</smokeStartSize>
          <smokeEndSize>0.9</smokeEndSize>
          <smokeOpacity>0.2</smokeOpacity>
        </exhaust>
      </li>
    </modExtensions>
    <uiOrder>2250</uiOrder>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
  </ThingDef>
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>SSR_TurretGun_CombinedAirDefense</defName>
    <label>弹炮合一近防炮</label>
    <description>弹炮合一系统的八管近防炮。</description>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>1.00</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>SSR.Combat.Offscreen.TurretRecoilVerb</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>SSR_Bullet_CombinedAirDefense</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>50</range>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <burstShotCount>1200</burstShotCount>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
        <requireLineOfSight>false</requireLineOfSight>
        <stopBurstWithoutLos>false</stopBurstWithoutLos>
      </li>
    </verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>SSR_Bullet_CombinedAirDefense</defName>
    <label>弹炮合一近防炮弹</label>
    <graphicData>
      <texPath>Things/Projectile/Electromagnetic_AR_rt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>SSR.Combat.Offscreen.Projectile_TurretPenetrating</thingClass>
    <projectile>
      <damageDef>Bullet</damageDef>
      <speed>500</speed>
      <damageAmountBase>20</damageAmountBase>
      <stoppingPower>2.5</stoppingPower>
    </projectile>
    <modExtensions>
      <li Class="HJ_SSR.Weapons.ModExtension_PenetratingProjectile">
        <overpenDamageMulti>0.5</overpenDamageMulti>
        <stopperDamageMulti>1.0</stopperDamageMulti>
        <PenetrationFloorPercentage>0.2</PenetrationFloorPercentage>
        <penetrationPotentialMultiplier>1.0</penetrationPotentialMultiplier>
        <postPenetrationDeviationAngle>0.0</postPenetrationDeviationAngle>
        <minSearchRadius>1.0</minSearchRadius>
        <maxSearchRadius>1.0</maxSearchRadius>
        <extraRange>1.0</extraRange>
        <buildingEquivalentMulti>0.005</buildingEquivalentMulti>
        <armorEquivalentMulti>1.0</armorEquivalentMulti>
        <bodysizeEquivalentMulti>0.1</bodysizeEquivalentMulti>
        <treeEquivalent>0.1</treeEquivalent>
        <chunkEquivalent>0.25</chunkEquivalent>
        <bounceEquivalent>0.2</bounceEquivalent>
        <straightPassThrough>true</straightPassThrough>
        <maxPenetratingCount>10</maxPenetratingCount>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>SSR_Projectile_GuidedDefenseMissile</defName>
    <label>筒射制导防空导弹</label>
    <thingClass>SSR.Combat.Offscreen.Projectile_GuidedDefenseMissile</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Missile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>60</damageAmountBase>
      <explosionRadius>2.5</explosionRadius>
      <explosionDelay>0</explosionDelay>
      <speed>60</speed>
      <flyOverhead>false</flyOverhead>
      <soundExplode>Explosion_Rocket</soundExplode>
    </projectile>
  </ThingDef>
</Defs>
