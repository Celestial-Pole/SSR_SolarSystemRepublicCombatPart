
#仓库保留模组运行资源与必需源码；Unity、美术工程和参考文档在仓库外维护。
#导弹配置源码同时供游戏程序集和外部 Unity 工程使用。
/src/SSR.Combat.UnityAsset/*
!/src/SSR.Combat.UnityAsset/Assets/
/src/SSR.Combat.UnityAsset/Assets/*
!/src/SSR.Combat.UnityAsset/Assets/SSR/
/src/SSR.Combat.UnityAsset/Assets/SSR/*
!/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/
/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/*
!/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/Runtime/
/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/Runtime/*
!/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/Runtime/*.cs
!/src/SSR.Combat.UnityAsset/Assets/SSR/Missiles/Runtime/*.cs.meta
/Docs/
*.blend
*.blend.meta
*.fbx
*.fbx.meta
*.psd
*.psd.meta

#编译缓存；版本加载目录中的运行 DLL 和 Asset 中的运行资源包随仓库维护。
**/Assemblies/*
!/1.4/Assemblies/*.dll
!/1.4/CombatExtended/Assemblies/*.dll
!/1.5/Assemblies/*.dll
!/1.5/CombatExtended/Assemblies/*.dll
!/1.6/Assemblies/*.dll
**/[Bb]in/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/BUILD/
**/BUILD.*/
**/BUILD_*/
**/AB_Pack/
**/[Oo]utput/
**/[Oo]utputs/
*.pdb
*.mdb

#Unity 自动生成的缓存、日志、本机布局和 IDE 工程文件。
**/[Ll]ibrary/
**/[Tt]emp/
**/[Ll]og/
**/[Ll]ogs/
**/UserSettings/
**/MemoryCaptures/
**/Recordings/
*.log
/src/SSR.Combat.UnityAsset/*.csproj
/src/SSR.Combat.UnityAsset/*.sln
/src/SSR.Combat.UnityAsset/*.slnx

#开发截图、本地文档及导入报告。
/Docs/Previews/**/*.png
**/[Ss]creenshots/
**/[Dd]ocumentation/
**/[Rr]eview/
/src/SSR.Combat.UnityAsset/ArtSource/**/*.md
/src/SSR.Combat.UnityAsset/ArtSource/T1Turrets/inventory.json
/src/SSR.Combat.UnityAsset/ArtSource/T1Turrets/removed-assets.json

#本机配置与编辑器临时文件；1.4/.vscode 中的源码、项目文件及构建脚本仍保留。
/.local/
/build.bat
/deploy_modSelf.bat
/LOCAL_DEV.md
**/.vs/
**/.idea/
**/.vscode/*.json
**/.vscode/.run/
*.suo
*.user
*.userprefs
*.pidb
*.opendb
*.VC.db
*.lnk
**/__pycache__/
*.py[cod]
*.blend[0-9]*
*.blend[0-9]*.meta
*~
*~.meta
